# Copie este arquivo para .env e preencha. O .env não vai para o Git.

# Google Maps — obrigatório (Places API (New) ativada no Google Cloud)
GOOGLE_MAPS_API_KEY=

# Telegram — obrigatório para receber os leads
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram — opcional (seguidores, posts, bio e último post)
# ID da SUA conta Instagram profissional + token de acesso da API do Instagram
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
